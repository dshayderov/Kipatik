# Образец настроек Kipatik.
#
# Скопируйте рядом с собой и правьте копию, а не этот файл:
#
#   cp backend/.env.example backend/.env
#
# Здесь перечислены только те переменные, которые меняют поведение
# или безопасность. У остальных есть рабочие значения по умолчанию,
# и полный перечень — в руководстве администратора (docs/admin-guide.md).
#
# ВАЖНО: приложение не стартует, если в .env есть переменная, которой
# нет в настройках. Неизвестная переменная обрывает запуск с ошибкой
# проверки, а не игнорируется.


# ── Обязательно заменить ────────────────────────────────────── #
# Ключ подписи токенов и базовый ключ шифрования токенов Git.
# Значение по умолчанию — это не ключ, а подсказка, что его сменили.
#
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_your_own

# Ключ шифрования токенов Git-провайдеров при хранении.
#
# Если оставить пустым, ключ выводится из SECRET_KEY. ВАЖНО: после того
# как токены шифровались, менять оба значения нельзя — сохранённые
# токены перестанут расшифровываться и придётся вводить их заново.
TOKEN_ENCRYPTION_KEY=

# Как долго живёт сессия пользователя, в минутах. 10080 — неделя.
ACCESS_TOKEN_EXPIRE_MINUTES=10080


# ── База данных и Redis ─────────────────────────────────────── #
# Локальная разработка: PostgreSQL и Redis подняты на этой машине.
# В Docker Compose эти два значения переопределяются на имя сервиса.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/diplom
REDIS_URL=redis://localhost:6379/0


# ── Публичный адрес сервера ─────────────────────────────────── #
# Провайдер отправляет вебхуки на
#   {PUBLIC_BASE_URL}/api/v1/git/webhook/{id_репозитория}
# ВАЖНО: адрес должен быть доступен из интернета, иначе вебхуки
# не доставятся. Тогда работает фоновая сверка по расписанию, но
# она медленнее: реакция на пуш вместо секунд — минут.
PUBLIC_BASE_URL=http://localhost:8000

# Автоматически регистрировать вебхук через API провайдера.
# Если у токена нет прав на управление вебхуками, поставьте false
# и добавьте вебхук вручную.
GIT_WEBHOOK_AUTO_REGISTER=true

# Фоновая сверка. Нужна там, где вебхуки теряются: она забирает
# пропущенные коммиты и приводит состояние в соответствие.
GIT_SYNC_ENABLED=true
GIT_SYNC_INTERVAL_SECONDS=300
GIT_SYNC_SINCE_DAYS=90


# ── Токены провайдеров ──────────────────────────────────────── #
# Пока эти пары пустые, работает запасной путь: пользователь сам
# вводит Personal Access Token в профиле. Кнопка «Войти через ...»
# появляется только у того провайдера, у которого заданы обе части.
#
# Как зарегистрировать приложение у провайдера — в руководстве
# администратора, раздел «Токены провайдеров и OAuth».
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Для self-hosted укажите свой адрес и регистрируйте приложение там же
GITLAB_HOST=https://gitlab.com

GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
GITEA_HOST=

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# Куда провайдер возвращает пользователя после согласия.
# Это адрес ФРОНТЕНДА, а не сервера. Если в нём есть путь — сохраняется.
OAUTH_FRONTEND_REDIRECT=http://localhost:3000/profile


# ── Нейросетевые модели ────────────────────────────────────── #
# Модели грузятся лениво и только по первому обращению, поэтому
# выключенная модель не мешает старту.
#
# Артефакты кладутся в папку app/ai/code_model рядом с кодом:
#   app/ai/code_model/commit_tracer.pt                 — кодировщик
#   app/ai/code_model/type_classifier.pt               — голова типов
#   app/ai/code_model/<имя модели>/                     — конфиг и словарь
#   app/ai/code_model/progress_estimator.py            — модуль правил
#
# Всё это лежит в репозитории: клонирование даёт готовый комплект.
# Крупные веса хранятся через Git LFS, поэтому перед клонированием
# выполните `git lfs install` — иначе файлы останутся указателями.
#
# Словарь при необходимости восстанавливается отдельно:
#   python backend/scripts/fetch_tokenizer.py
#
# CODE_MODEL_DIR задавайте, только если артефакты лежат не там:
# пусто — искать рядом с кодом, в контейнере путь проставлен.
CODE_MODEL_ENABLED=true
CODE_MODEL_DIR=
CODE_MODEL_TRACER_FILE=commit_tracer.pt
CODE_MODEL_CLASSIFIER_FILE=type_classifier.pt
CODE_MODEL_DEVICE=auto

# Порог привязки коммита к задаче. Ниже порога решение остаётся
# за человеком: модель лишь предлагает, а не привязывает сама.
CODE_MODEL_TRACE_THRESHOLD=0.30
CODE_MODEL_TRACE_LIMIT=20
CODE_MODEL_TRACE_BUDGET_SECONDS=5.0

# Определять тип коммита при привязке к задаче. Работает поверх
# кодировщика: при CODE_MODEL_ENABLED=false не сработает.
CODE_MODEL_CLASSIFY=true


# ── Тексты изменений ────────────────────────────────────────── #
# Нужны моделям: без них модель видит только имя файла и работает
# заметно хуже. Запрашиваются отдельным запросом на каждый коммит,
# поэтому включать стоит осознанно.
GIT_FETCH_PATCHES=false
GIT_MAX_PATCH_CHARS=4000
GIT_PATCH_BACKFILL_LIMIT=50
GIT_PATCH_BACKFILL_DELAY=0.3

# Трассировка по смыслу при фоновой сверке. На CPU модель даёт
# сотни миллисекунд на коммит, поэтому в саму сверку она не идёт.
GIT_TRACE_ON_SYNC=false
GIT_TRACE_SYNC_LIMIT=10
GIT_TRACE_FETCH_PATCHES=false


# ── Оценка прогресса задачи ────────────────────────────────── #
# Модуль правил, нейросеть не требуется.
#
# PROGRESS_DEFAULT_EXPECTED_VOLUME — ожидаемый объём на задачу в
# строках, пока не набралось данных для калибровки по проекту.
PROGRESS_ENABLED=true
PROGRESS_DEFAULT_EXPECTED_VOLUME=200
PROGRESS_MIN_TASKS_FOR_CALIBRATION=3
PROGRESS_CALIBRATION_PRIOR_STRENGTH=3
PROGRESS_HISTORY_DAYS=30


# ── Руководства ─────────────────────────────────────────────── #
# Тексты лежат в docs/ рядом с этой папкой и отдаются по адресу
# /manuals/<имя файла>. Те же файлы открываются как Markdown в Git.
#
# По умолчанию выключено: руководство администратора перечисляет
# секреты и переменные окружения. Включайте только там, где доступ
# к таким файлам допустим.
#
# Адрес /docs занят встроенной документацией API и не имеет к
# руководствам отношения.
SERVE_DOCS=false

# Где искать папку с руководствами. Обычно не нужно: приложение
# ищет её рядом с собой. Значение требуется в контейнере, где
# структура папок другая.
DOCS_DIR=